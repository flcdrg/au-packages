<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>codegraph</id>
    <title>CodeGraph</title>
    <version>1.6.2</version>
    <authors>Colby Mchenry</authors>
    <owners>flcdrg</owners>
    <projectUrl>https://colbymchenry.github.io/codegraph/</projectUrl>
    <projectSourceUrl>https://github.com/colbymchenry/codegraph</projectSourceUrl>
    <docsUrl>https://colbymchenry.github.io/codegraph/</docsUrl>
    <bugTrackerUrl>https://github.com/colbymchenry/codegraph/issues</bugTrackerUrl>
    <packageSourceUrl>https://github.com/flcdrg/au-packages/tree/master/codegraph</packageSourceUrl>
    <tags>codegraph code-intelligence knowledge-graph static-analysis ai developer-tools</tags>
    <copyright>Copyright © 2026 Colby Mchenry</copyright>
    <licenseUrl>https://github.com/colbymchenry/codegraph/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Build a local code knowledge graph for semantic code intelligence.</summary>
    <description>CodeGraph builds a local, queryable knowledge graph of a codebase to provide semantic code intelligence to AI coding agents. It parses code across 20+ languages, exposes an MCP server, and supports symbol impact analysis. The Windows bundle includes its own Node.js runtime; Node.js is not required separately.</description>
    <releaseNotes>https://github.com/colbymchenry/codegraph/releases/tag/v1.6.2</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
